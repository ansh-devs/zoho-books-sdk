{
  "name": "zoho-books-sdk",
  "version": "0.1.0",
  "description": "Type safe, zero dependency Node.js SDK for the Zoho Books API v3: invoicing, India GST, e invoicing, payments, OAuth across all data centers, rate limiting and auto pagination.",
  "keywords": [
    "zoho",
    "zoho-books",
    "zohobooks",
    "invoice",
    "invoicing",
    "gst",
    "india",
    "e-invoice",
    "accounting",
    "sdk",
    "typescript"
  ],
  "license": "MIT",
  "author": "ansh-devs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ansh-devs/zoho-books-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/ansh-devs/zoho-books-sdk/issues"
  },
  "homepage": "https://github.com/ansh-devs/zoho-books-sdk#readme",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18.17"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "gst": [
        "./dist/gst/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./gst": {
      "import": {
        "types": "./dist/gst/index.d.ts",
        "default": "./dist/gst/index.js"
      },
      "require": {
        "types": "./dist/gst/index.d.cts",
        "default": "./dist/gst/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:package": "publint && attw --pack .",
    "check": "npm run typecheck && npm test && npm run build && npm run lint:package",
    "prepublishOnly": "npm run check"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.20.5",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
